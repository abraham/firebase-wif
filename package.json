{
  "name": "@abraham/firebase-wif",
  "version": "0.0.0",
  "description": "Set up and check Firebase deploys from GitHub Actions with Workload Identity Federation",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "firebase-wif": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "default": "./dist/presets.js"
    },
    "./credentials": {
      "types": "./dist/credentials.d.ts",
      "default": "./dist/credentials.js"
    },
    "./gh": {
      "types": "./dist/gh.d.ts",
      "default": "./dist/gh.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/action"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:action": "esbuild src/action/main.ts src/action/post.ts --bundle --platform=node --target=node24 --format=esm --legal-comments=none --outdir=dist/action",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "optionalDependencies": {
    "google-auth-library": "^11.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "typescript": "^6.0.0",
    "vitest": "^5.0.0"
  }
}
